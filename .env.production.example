# Copy this file to .env.production only when running production mode outside Vercel.
# On Vercel, configure these values in Project Settings > Environment Variables instead.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-24-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://your-frontend.example.com
