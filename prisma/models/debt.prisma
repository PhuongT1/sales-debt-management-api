enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum CollectionStatus {
  NEW
  CONTACTED
  PROMISED
  DISPUTED
  ESCALATED
}

model Debt {
  id               String           @id @default(cuid())
  code             String           @unique
  type             DebtType
  partyId          String
  assignedToId     String?
  title            String
  invoiceNo        String?
  orderNo          String?
  contractNo       String?
  poNo             String?
  description      String?
  originalAmount   Decimal          @db.Decimal(18, 2)
  paidAmount       Decimal          @default(0) @db.Decimal(18, 2)
  currency         String           @default("VND")
  issueDate        DateTime
  dueDate          DateTime
  status           DebtStatus       @default(OPEN)
  collectionStatus CollectionStatus @default(NEW)
  nextFollowUpAt   DateTime?
  followUpNote     String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  party      Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  assignedTo User?     @relation("DebtAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@index([type])
  @@index([status])
  @@index([collectionStatus])
  @@index([dueDate])
  @@index([nextFollowUpAt])
  @@index([partyId])
  @@index([assignedToId])
}
